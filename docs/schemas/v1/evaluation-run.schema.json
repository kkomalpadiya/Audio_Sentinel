{
  "$defs": {
    "BinaryEvaluationMetrics": {
      "additionalProperties": false,
      "properties": {
        "accuracy": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accuracy"
        },
        "balanced_accuracy": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Balanced Accuracy"
        },
        "evaluated_count": {
          "minimum": 0,
          "title": "Evaluated Count",
          "type": "integer"
        },
        "f1": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "F1"
        },
        "false_negative": {
          "minimum": 0,
          "title": "False Negative",
          "type": "integer"
        },
        "false_negative_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "False Negative Rate"
        },
        "false_positive": {
          "minimum": 0,
          "title": "False Positive",
          "type": "integer"
        },
        "false_positive_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "False Positive Rate"
        },
        "negative_count": {
          "minimum": 0,
          "title": "Negative Count",
          "type": "integer"
        },
        "positive_count": {
          "minimum": 0,
          "title": "Positive Count",
          "type": "integer"
        },
        "precision": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precision"
        },
        "recall": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recall"
        },
        "specificity": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Specificity"
        },
        "true_negative": {
          "minimum": 0,
          "title": "True Negative",
          "type": "integer"
        },
        "true_positive": {
          "minimum": 0,
          "title": "True Positive",
          "type": "integer"
        }
      },
      "required": [
        "evaluated_count",
        "positive_count",
        "negative_count",
        "true_positive",
        "false_positive",
        "false_negative",
        "true_negative"
      ],
      "title": "BinaryEvaluationMetrics",
      "type": "object"
    },
    "ConsensusOutcome": {
      "description": "The one primary action selected by the verification layer.",
      "enum": [
        "no_action",
        "log",
        "review",
        "alert"
      ],
      "title": "ConsensusOutcome",
      "type": "string"
    },
    "EvaluationCaseResult": {
      "additionalProperties": false,
      "description": "Privacy-minimized case result; it deliberately omits source paths.",
      "properties": {
        "alert_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 3,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alert Id"
        },
        "audit_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 3,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audit Id"
        },
        "case_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Case Id",
          "type": "string"
        },
        "categories": {
          "items": {
            "maxLength": 128,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "title": "Categories",
          "type": "array"
        },
        "clip_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Clip Id",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9_]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "expected_outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConsensusOutcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "expected_positive": {
          "title": "Expected Positive",
          "type": "boolean"
        },
        "observed_outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConsensusOutcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "observed_positive": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Positive"
        },
        "report_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 3,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Id"
        },
        "risk_score": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Risk Score"
        },
        "risk_severity": {
          "anyOf": [
            {
              "$ref": "#/$defs/RiskLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "enum": [
            "completed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "clip_id",
        "categories",
        "expected_positive",
        "status"
      ],
      "title": "EvaluationCaseResult",
      "type": "object"
    },
    "EvaluationMetrics": {
      "additionalProperties": false,
      "properties": {
        "binary": {
          "$ref": "#/$defs/BinaryEvaluationMetrics"
        },
        "completed_case_count": {
          "minimum": 0,
          "title": "Completed Case Count",
          "type": "integer"
        },
        "completion_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Completion Rate",
          "type": "number"
        },
        "failed_case_count": {
          "minimum": 0,
          "title": "Failed Case Count",
          "type": "integer"
        },
        "outcome_accuracy": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome Accuracy"
        },
        "outcome_labeled_count": {
          "minimum": 0,
          "title": "Outcome Labeled Count",
          "type": "integer"
        },
        "outcome_match_count": {
          "minimum": 0,
          "title": "Outcome Match Count",
          "type": "integer"
        },
        "total_case_count": {
          "minimum": 1,
          "title": "Total Case Count",
          "type": "integer"
        }
      },
      "required": [
        "total_case_count",
        "completed_case_count",
        "failed_case_count",
        "completion_rate",
        "binary",
        "outcome_labeled_count",
        "outcome_match_count"
      ],
      "title": "EvaluationMetrics",
      "type": "object"
    },
    "RiskLevel": {
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "RiskLevel",
      "type": "string"
    }
  },
  "$id": "https://audio-sentinel.local/schemas/v1/evaluation-run.schema.json",
  "additionalProperties": false,
  "description": "Deterministic metric report with explicit operational coverage.",
  "properties": {
    "alert_delivery_authorized": {
      "const": false,
      "default": false,
      "enum": [
        false
      ],
      "title": "Alert Delivery Authorized",
      "type": "boolean"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/EvaluationCaseResult"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decision_status": {
      "enum": [
        "complete",
        "incomplete_due_to_failures"
      ],
      "title": "Decision Status",
      "type": "string"
    },
    "document_type": {
      "const": "evaluation_run",
      "default": "evaluation_run",
      "enum": [
        "evaluation_run"
      ],
      "title": "Document Type",
      "type": "string"
    },
    "manifest_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Manifest Id",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "manifest_size_bytes": {
      "exclusiveMinimum": 0,
      "title": "Manifest Size Bytes",
      "type": "integer"
    },
    "metrics": {
      "$ref": "#/$defs/EvaluationMetrics"
    },
    "notification_delivery": {
      "const": "not_sent",
      "default": "not_sent",
      "enum": [
        "not_sent"
      ],
      "title": "Notification Delivery",
      "type": "string"
    },
    "positive_outcomes": {
      "items": {
        "$ref": "#/$defs/ConsensusOutcome"
      },
      "title": "Positive Outcomes",
      "type": "array"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "enum": [
        "1.0"
      ],
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "created_at",
    "manifest_id",
    "manifest_sha256",
    "manifest_size_bytes",
    "positive_outcomes",
    "decision_status",
    "metrics",
    "cases"
  ],
  "title": "EvaluationRunDocument",
  "type": "object"
}
