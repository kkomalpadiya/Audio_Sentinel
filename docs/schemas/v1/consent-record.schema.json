{
  "$defs": {
    "ConsentStatus": {
      "enum": [
        "granted",
        "denied",
        "withdrawn"
      ],
      "title": "ConsentStatus",
      "type": "string"
    },
    "ProcessingScope": {
      "enum": [
        "none",
        "acoustic_only",
        "acoustic_and_speech"
      ],
      "title": "ProcessingScope",
      "type": "string"
    }
  },
  "$id": "https://audio-sentinel.local/schemas/v1/consent-record.schema.json",
  "additionalProperties": false,
  "description": "Permission evidence for a clip, without storing personal information.",
  "properties": {
    "consent_id": {
      "description": "Opaque reference to the consent record held outside this manifest.",
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Consent Id",
      "type": "string"
    },
    "device_authorized": {
      "title": "Device Authorized",
      "type": "boolean"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "granted_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Granted At"
    },
    "processing_scope": {
      "$ref": "#/$defs/ProcessingScope"
    },
    "raw_audio_retention_allowed": {
      "default": false,
      "title": "Raw Audio Retention Allowed",
      "type": "boolean"
    },
    "status": {
      "$ref": "#/$defs/ConsentStatus"
    }
  },
  "required": [
    "consent_id",
    "status",
    "processing_scope",
    "device_authorized"
  ],
  "title": "ConsentRecord",
  "type": "object"
}
