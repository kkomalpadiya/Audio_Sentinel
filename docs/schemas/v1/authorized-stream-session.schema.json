{
  "$defs": {
    "ProcessingScope": {
      "enum": [
        "none",
        "acoustic_only",
        "acoustic_and_speech"
      ],
      "title": "ProcessingScope",
      "type": "string"
    },
    "StreamAudioFormat": {
      "additionalProperties": false,
      "description": "Bounded in-memory PCM format accepted by the future ingestion service.",
      "properties": {
        "channels": {
          "maximum": 8,
          "minimum": 1,
          "title": "Channels",
          "type": "integer"
        },
        "chunk_duration_ms": {
          "maximum": 1000,
          "minimum": 10,
          "title": "Chunk Duration Ms",
          "type": "integer"
        },
        "encoding": {
          "const": "pcm_s16le",
          "default": "pcm_s16le",
          "enum": [
            "pcm_s16le"
          ],
          "title": "Encoding",
          "type": "string"
        },
        "sample_rate_hz": {
          "maximum": 192000,
          "minimum": 8000,
          "title": "Sample Rate Hz",
          "type": "integer"
        },
        "sample_width_bytes": {
          "const": 2,
          "default": 2,
          "enum": [
            2
          ],
          "title": "Sample Width Bytes",
          "type": "integer"
        }
      },
      "required": [
        "sample_rate_hz",
        "channels",
        "chunk_duration_ms"
      ],
      "title": "StreamAudioFormat",
      "type": "object"
    }
  },
  "$id": "https://audio-sentinel.local/schemas/v1/authorized-stream-session.schema.json",
  "additionalProperties": false,
  "description": "Bounded authorization result; it is not proof of an incident or alert authority.",
  "properties": {
    "alert_delivery_authorized": {
      "const": false,
      "default": false,
      "enum": [
        false
      ],
      "title": "Alert Delivery Authorized",
      "type": "boolean"
    },
    "audio_format": {
      "$ref": "#/$defs/StreamAudioFormat"
    },
    "authentication_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Authentication Id",
      "type": "string"
    },
    "authorized_at": {
      "format": "date-time",
      "title": "Authorized At",
      "type": "string"
    },
    "consent_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Consent Id",
      "type": "string"
    },
    "device_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Device Id",
      "type": "string"
    },
    "enrollment_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Enrollment Id",
      "type": "string"
    },
    "enrollment_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Enrollment Sha256",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "external_action_authorized": {
      "const": false,
      "default": false,
      "enum": [
        false
      ],
      "title": "External Action Authorized",
      "type": "boolean"
    },
    "interface_version": {
      "const": "1.0",
      "default": "1.0",
      "enum": [
        "1.0"
      ],
      "title": "Interface Version",
      "type": "string"
    },
    "notification_delivery": {
      "const": "not_sent",
      "default": "not_sent",
      "enum": [
        "not_sent"
      ],
      "title": "Notification Delivery",
      "type": "string"
    },
    "processing_scope": {
      "$ref": "#/$defs/ProcessingScope"
    },
    "raw_audio_persistence_allowed": {
      "title": "Raw Audio Persistence Allowed",
      "type": "boolean"
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Session Id",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "enrollment_id",
    "enrollment_sha256",
    "authentication_id",
    "device_id",
    "consent_id",
    "processing_scope",
    "audio_format",
    "authorized_at",
    "expires_at",
    "raw_audio_persistence_allowed"
  ],
  "title": "AuthorizedStreamSession",
  "type": "object"
}
